<div class="search-overlay" id="search-overlay" data-search-url="<%- url_for('/search.json') %>" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="search-box">
      <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
      </svg>
      <input id="search-input" class="search-input" type="search" placeholder="搜索文章标题、正文、标签…" autocomplete="off" spellcheck="false" aria-label="搜索关键词">
      <button class="search-close" type="button" aria-label="关闭搜索">Esc</button>
    </div>
    <div class="search-meta" id="search-meta"></div>
    <div class="search-results" id="search-results" role="listbox"></div>
    <div class="search-hint">
      <span><kbd>/</kbd> 唤起</span>
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>
