<article class="post-card">
  <h2 class="post-card-title">
    <a href="<%- url_for(post.path) %>"><%= post.title || '(Untitled)' %></a>
  </h2>
  <div class="post-card-meta">
    <time datetime="<%- date_xml(post.date) %>"><%- date(post.date, 'YYYY-MM-DD') %></time>
    <% if (post.categories && post.categories.length) { %>
      <span class="separator">&middot;</span>
      <% post.categories.each(function(cat){ %>
        <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
      <% }) %>
    <% } %>
  </div>
  <div class="post-card-excerpt">
    <% if (post.excerpt) { %>
      <%- post.excerpt %>
    <% } else { %>
      <%
        // Extract meaningful text for excerpt from rendered HTML:
        var content = post.content;
        // 1. Remove highlight code blocks (Hexo wraps in <figure class="highlight">)
        content = content.replace(/<figure[^>]*>[\s\S]*?<\/figure>/gi, '');
        // 2. Remove tables, images, blockquotes, inline code
        content = content.replace(/<table[\s\S]*?<\/table>/gi, '');
        content = content.replace(/<img[^>]*>/gi, '');
        content = content.replace(/<blockquote[\s\S]*?<\/blockquote>/gi, '');
        content = content.replace(/<code[^>]*>.*?<\/code>/gi, '');
        // 3. Remove heading tags but keep their text content
        content = content.replace(/<\/?h[1-6][^>]*>/gi, ' ');
        // 4. Strip remaining HTML tags
        var text = strip_html(content).trim();
        // 5. Replace repeated newlines with period+space for readability
        text = text.replace(/\n\s*\n/g, '. ').replace(/\n/g, ' ');
        // 6. Collapse multiple spaces
        text = text.replace(/[ \t]+/g, ' ').trim();
        // 7. Take first 200 chars, break at sentence boundary
        if (text.length > 200) {
          var excerpt = text.substring(0, 200);
          var cut = Math.max(
            excerpt.lastIndexOf('。'),
            excerpt.lastIndexOf('！'),
            excerpt.lastIndexOf('？'),
            excerpt.lastIndexOf('. '),
            excerpt.lastIndexOf(' ')
          );
          if (cut > 100) excerpt = excerpt.substring(0, cut + 1);
        } else {
          var excerpt = text;
        }
      %>
      <p><%- excerpt %>...</p>
    <% } %>
  </div>
  <a class="read-more" href="<%- url_for(post.path) %>"><%= theme.excerpt_link || 'Read More' %> &rarr;</a>
  <% if (post.tags && post.tags.length) { %>
    <div class="post-card-tags">
      <% post.tags.each(function(tag){ %>
        <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
      <% }) %>
    </div>
  <% } %>
</article>
